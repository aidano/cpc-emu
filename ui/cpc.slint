export component CpcWindow inherits Window {
    title: "CPC Emu";
    width: 1280px;
    height: 800px;

    in property <image> frame;
    callback key(string, int, bool, bool, bool);

    FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(e) => {
            root.key(e.text, 1, e.modifiers.control, e.modifiers.meta, e.repeat);
            accept
        }

        key-released(e) => {
            root.key(e.text, 0, e.modifiers.control, e.modifiers.meta, e.repeat);
            accept
        }

        Image {
            source: frame;
            width: parent.width;
            height: parent.height;
            image-rendering: pixelated;
        }
    }
}
