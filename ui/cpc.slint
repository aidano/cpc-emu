export component CpcWindow inherits Window {
    title: "CPC Emu";
    width: 1280px;
    height: 400px;

    in property <image> frame;
    callback key(string, int);

    FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(e) => {
            root.key(e.text, 1);
            accept
        }

        key-released(e) => {
            root.key(e.text, 0);
            accept
        }

        Image {
            source: frame;
            width: parent.width;
            height: parent.height;
            image-rendering: pixelated;
        }
    }
}
